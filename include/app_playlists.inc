std::string playlistID;int playlistRootSelected=0;
const nlohmann::json *savedPlaylist(const std::string &id)const{for(auto &p:catalog["playlists"])if(p["id"]==id)return &p;return nullptr;}
std::string currentAlbumKey()const{return page==10?"playlist:"+playlistID:page==8?"disc":collectionAlbumID;}
void createPlaylist(nlohmann::json pending=nlohmann::json{}){std::string name;if(!keyboard("Playlist name",name))return;if(independent){hostMutate("playlist_save",{{"name",name}},[this,pending](auto result){if(pending.is_object()){auto request=pending;request["id"]=result.at("id");request["catalog_revision"]=catalog["revision"];hostCommand("playlist_add",request);}});return;}auto old=catalog["playlists"].size();if(catalogCommand({{"op","playlist_save"},{"name",name}})&&pending.is_object()&&catalog["playlists"].size()>old){pending["op"]="playlist_add";pending["id"]=catalog["playlists"].back()["id"];catalogCommand(pending);}}
void addToPlaylist(nlohmann::json track){std::vector<nlohmann::json> values={"new"};std::vector<std::string> labels={"+ Create playlist"};for(auto &p:catalog["playlists"]){values.push_back(p["id"]);labels.push_back(p["name"]);}choose("Add track to playlist",values,labels,values.front(),[this,track](auto id)mutable{if(id=="new")createPlaylist(track);else{track["op"]="playlist_add";track["id"]=id;catalogCommand(track);}});}
void addSelectedFileToPlaylist(){if(selected<0||selected>=int(entries.size())||entries[selected].directory){status="Highlight a music track first.";return;}addToPlaylist({{"source_ref",sourceReference(source)},{"path",entries[selected].path}});}
void fileActions(){if(selected>=0&&selected<int(entries.size())&&!entries[selected].directory)choose("Track / folder actions",{0,1},{"Add track to playlist","Add album to Collections"},0,[this](auto choice){if(choice.template get<int>()==0)addSelectedFileToPlaylist();else addAlbum();});else addAlbum();}
void addSelectedAlbumTrackToPlaylist(){auto a=collectionAlbum(collectionAlbumID);auto rows=albumPage(collectionAlbumID).value("tracks",nlohmann::json::array());if(a&&selected>=0&&selected<int(rows.size()))addToPlaylist({{"source_ref",(*a)["source"]},{"path",rows[selected]["path"]}});}
void openPlaylist(const nlohmann::json &p){playlistRootSelected=selected;playlistID=p["id"];page=10;selected=scroll=0;}
void managePlaylist(const nlohmann::json &p){choose("Manage playlist",{0,1,2,3},{"Rename playlist","Delete playlist (keep music files)","Create playlist",libraryViewLabel("playlists_view")},0,[this,p](auto choice){if(choice.template get<int>()==3){libraryViewChoice("playlists_view");return;}if(choice.template get<int>()==2){createPlaylist();return;}if(choice.template get<int>()==0){std::string name=p["name"];if(keyboard("Playlist name",name))catalogCommand({{"op","playlist_save"},{"id",p["id"]},{"name",name}});}else choose("Delete this playlist?",{false,true},{"Cancel","Delete"},false,[this,p](auto yes){if(yes.template get<bool>()&&catalogCommand({{"op","playlist_remove"},{"id",p["id"]}})){playlistID.clear();if(page==10){page=9;selected=scroll=0;}}});});optionSeparator=2;}
void playlistTrackActions(){auto p=savedPlaylist(playlistID);if(!p||selected<0||selected>=int((*p)["tracks"].size()))return;auto track=(*p)["tracks"][selected];choose(track.value("title",std::string("Track")),{0,1,2},{"Remove from playlist","Move up","Move down"},0,[this,track](auto choice){int action=choice.template get<int>();nlohmann::json request={{"op",action==0?"playlist_remove_track":"playlist_move"},{"id",playlistID},{"track_id",track["id"]}};if(action)request["direction"]=action==1?-1:1;catalogCommand(request);});}
