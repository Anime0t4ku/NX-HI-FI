std::string playlistID;int playlistRootSelected=0;
const nlohmann::json *savedPlaylist(const std::string &id)const{for(auto &p:catalog["playlists"])if(p["id"]==id)return &p;return nullptr;}
std::string currentAlbumKey()const{return page==10?"playlist:"+playlistID:page==8?"disc":collectionAlbumID;}
void createPlaylist(nlohmann::json pending=nlohmann::json{}){std::string name;if(!keyboard("Playlist name",name))return;if(independent){hostMutate("playlist_save",{{"name",name}},[this,pending](auto result){if(pending.is_object()){auto request=pending;request["id"]=result.at("id");request["catalog_revision"]=catalog["revision"];hostCommand(request.value("album_folder",false)?"playlist_add_album":"playlist_add",request);}});return;}auto old=catalog["playlists"].size();if(catalogCommand({{"op","playlist_save"},{"name",name}})&&pending.is_object()&&catalog["playlists"].size()>old){pending["op"]=pending.value("album_folder",false)?"playlist_add_album":"playlist_add";pending["id"]=catalog["playlists"].back()["id"];catalogCommand(pending);}}
void addToPlaylist(nlohmann::json track){std::vector<nlohmann::json> values={"new"};std::vector<std::string> labels={"+ Create playlist"};for(auto &p:catalog["playlists"]){values.push_back(p["id"]);labels.push_back(p["name"]);}choose(track.value("album_folder",false)?"Add album tracks to playlist":"Add track to playlist",values,labels,values.front(),[this,track](auto id)mutable{if(id=="new")createPlaylist(track);else{track["op"]=track.value("album_folder",false)?"playlist_add_album":"playlist_add";track["id"]=id;catalogCommand(track);}});}
void addSelectedFileToPlaylist(){if(selected<0||selected>=int(entries.size())||entries[selected].directory){status="Highlight a music track first.";return;}addToPlaylist({{"source_ref",sourceReference(source)},{"path",entries[selected].path}});}
void fileActions(){
 if(movingItems||selected<0||selected>=int(entries.size()))return;
 if(!entries[selected].directory){choose("Track actions",{0},{"Add track to playlist"},0,[this](auto){addSelectedFileToPlaylist();});return;}
 choose("Album actions",{0,1},{"Add album to collection","Add all tracks from album to playlist"},0,[this](auto choice){if(choice.template get<int>()==0)addAlbum();else addToPlaylist({{"source_ref",sourceReference(source)},{"path",entries[selected].path},{"album_folder",true}});});
}
void addSelectedAlbumTrackToPlaylist(){auto a=collectionAlbum(collectionAlbumID);auto rows=albumPage(collectionAlbumID).value("tracks",nlohmann::json::array());if(a&&selected>=0&&selected<int(rows.size()))addToPlaylist({{"source_ref",(*a)["source"]},{"path",rows[selected]["path"]}});}
void openPlaylist(const nlohmann::json &p){playlistRootSelected=selected;playlistID=p["id"];page=10;selected=scroll=0;}
void managePlaylist(const nlohmann::json &p){choose("Manage playlist",{0,1,2,3,4,5},{"Rename playlist","Delete playlist (keep music files)","Create playlist",libraryViewLabel("playlists_view"),"Use playlist artwork as player art","Sort order"},0,[this,p](auto choice){if(choice.template get<int>()==5){sortLibraryItems(true,p["id"]);return;}if(choice.template get<int>()==4){choose("Use playlist artwork as player art",{"inherit","on","off"},{"Use general setting","On","Off"},p.value("artwork_mode",std::string("inherit")),[this,p](auto mode){catalogCommand({{"op","playlist_save"},{"id",p["id"]},{"name",p["name"]},{"artwork_mode",mode}});});return;}if(choice.template get<int>()==3){libraryViewChoice("playlists_view");return;}if(choice.template get<int>()==2){createPlaylist();return;}if(choice.template get<int>()==0){std::string name=p["name"];if(keyboard("Playlist name",name))catalogCommand({{"op","playlist_save"},{"id",p["id"]},{"name",name}});}else choose("Delete this playlist?",{false,true},{"Cancel","Delete"},false,[this,p](auto yes){if(yes.template get<bool>()&&catalogCommand({{"op","playlist_remove"},{"id",p["id"]}})){playlistID.clear();if(page==10){page=9;selected=scroll=0;}}});});optionSeparator=2;}
void playlistTrackActions(){if(movingItems)return;auto p=savedPlaylist(playlistID);if(!p||selected<0||selected>=int((*p)["tracks"].size()))return;auto track=(*p)["tracks"][selected];std::vector<nlohmann::json> values={0};std::vector<std::string> labels={"Remove from playlist"};if(p->value("sort",std::string("custom"))=="custom"){values.push_back(1);labels.push_back("Move track");}choose(track.value("title",std::string("Track")),values,labels,0,[this,track](auto choice){if(choice.template get<int>()==1)beginItemMove(true,playlistID,selected);else catalogCommand({{"op","playlist_remove_track"},{"id",playlistID},{"track_id",track["id"]}});});}

std::string playlistPlayerArtwork(const Playback &p)const{if(p.track.playlist.empty()){auto album=playbackAlbum(p);return album?collection->coverPath(album->at("id")):std::string{};}auto list=savedPlaylist(p.track.playlist);if(!list)return {};return collection->imagePath("playlist",p.track.playlist)+"";}
bool preferPlaylistArtwork(const Playback &p)const{auto list=savedPlaylist(p.track.playlist);if(!list)return playbackAlbum(p)!=nullptr;auto mode=list->value("artwork_mode",std::string("inherit"));return mode=="on"||(mode=="inherit"&&settings.playlistArtwork);}
