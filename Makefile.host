# Optional Linux build for UI/protocol regression work (no real optical backend).
CXX ?= c++
BUILD := build-host/preview
CPPFLAGS += -DSDL_MAIN_HANDLED -Iinclude -Ithird_party -Ithird_party/libsmb2/include $(HOST_EXTRA_CFLAGS)
CXXFLAGS += -std=c++17 -O1 -pthread
SOURCES := $(wildcard source/*.cpp)
OBJECTS := $(patsubst source/%.cpp,$(BUILD)/%.o,$(SOURCES))
HOST_SMB_LIB ?= -lsmb2
FFMPEG_LIBS ?= -lavformat -lavcodec -lswresample -lavutil
HOST_EXTRA_LIBS ?= -lSDL2 -lSDL2_image -lSDL2_ttf -lpng -ljpeg -lcurl
HOST_EXTRA_LIBS += $(FFMPEG_LIBS)
all: build-host/nx-preview
$(BUILD)/%.o: source/%.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
build-host/nx-preview: $(OBJECTS) build-host/decoder.o build-host/cover_codec.o
	$(CXX) -pthread $^ $(HOST_SMB_LIB) $(HOST_EXTRA_LIBS) -lm -lz -ldl -o $@
-include $(OBJECTS:.o=.d)

# Exercise the real application input/draw path with SDL dummy output.
$(BUILD)/app_player_test.o: tests/app200_test.cpp source/main.cpp $(wildcard include/*.hpp include/*.inc)
	@mkdir -p $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
build-host/nx-player-test: $(BUILD)/app_player_test.o $(filter-out $(BUILD)/main.o,$(OBJECTS)) build-host/decoder.o build-host/cover_codec.o
	$(CXX) -pthread $^ $(HOST_SMB_LIB) $(HOST_EXTRA_LIBS) -lm -lz -ldl -Wl,--wrap=SDL_CreateRGBSurfaceWithFormat -o $@
.PHONY: test-player
test-player: build-host/nx-player-test
	./build-host/nx-player-test

# Decoder/cover objects are built from source in a fresh checkout.
build-host/decoder.o: source/decoder.c $(wildcard include/*.h include/*.hpp)
	@mkdir -p build-host
	$(CC) $(CPPFLAGS) -O1 -c $< -o $@
build-host/cover_codec.o: source/cover_codec.c $(wildcard include/*.h)
	@mkdir -p build-host
	$(CC) $(CPPFLAGS) -O1 -c $< -o $@

# Album-library/radio/M4A integration checks (fixtures generated by tools/test_features140.sh).
$(BUILD)/app140_test.o: tests/app140_test.cpp source/main.cpp $(wildcard include/*.hpp include/*.inc)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
build-host/app140: $(BUILD)/app140_test.o $(filter-out $(BUILD)/main.o,$(OBJECTS)) build-host/decoder.o build-host/cover_codec.o
	$(CXX) -pthread $^ $(HOST_SMB_LIB) $(HOST_EXTRA_LIBS) -lm -lz -ldl -Wl,--wrap=_ZN3nxh22detectedStorageDevicesEv -Wl,--wrap=_ZN3nxh13currentDiscIDB5cxx11Ev -Wl,--wrap=_ZN3nxh9ejectDiscERNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE -Wl,--wrap=_ZN3nxh13listDirectoryERKNS_6SourceERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEERSt6vectorINS_5EntryESaISC_EERS8_ -Wl,--wrap=_ZN3nxh11discDetailsERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE -Wl,--wrap=_ZN3nxh9discCoverERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE -o $@
build-host/features140: tests/features140_test.cpp $(filter-out $(BUILD)/main.o,$(OBJECTS)) build-host/decoder.o build-host/cover_codec.o
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $^ $(HOST_SMB_LIB) $(HOST_EXTRA_LIBS) -lm -lz -ldl -o $@

$(BUILD)/player_files_test.o: tests/player_files_test.cpp $(wildcard include/*.hpp)
	@mkdir -p $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@
build-host/player-files-test: $(BUILD)/player_files_test.o $(filter-out $(BUILD)/main.o,$(OBJECTS)) build-host/decoder.o build-host/cover_codec.o
	$(CXX) -pthread $^ $(HOST_SMB_LIB) $(HOST_EXTRA_LIBS) -lm -lz -ldl -Wl,--wrap=SDL_ClearQueuedAudio -o $@

$(BUILD)/smb_startup_test.o: tests/smb_startup_test.cpp $(wildcard include/*.hpp)
	@mkdir -p $(BUILD)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@
build-host/smb-startup-test: $(BUILD)/smb_startup_test.o $(filter-out $(BUILD)/main.o,$(OBJECTS)) build-host/decoder.o build-host/cover_codec.o
	$(CXX) -pthread $^ $(HOST_SMB_LIB) $(HOST_EXTRA_LIBS) -lm -lz -ldl -Wl,--wrap=smb2_connect_share -Wl,--wrap=smb2_open -Wl,--wrap=smb2_fstat -Wl,--wrap=smb2_pread -Wl,--wrap=smb2_close -o $@
